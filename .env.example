# ===== Server =====
PORT=3000
NODE_ENV=development
TZ=America/Bogota

# ===== Supabase (authentication only) =====
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
# The service-role key lives ONLY on the server (never in the views). The Director uses it to create/edit users.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
# Domain appended to bare usernames: "jdoe" -> "jdoe@<domain>"
INSTITUTIONAL_DOMAIN=udi.edu.co

# ===== PostgreSQL (Neon) =====
# DB_SSL=false   # only if you use a local PostgreSQL without SSL
# Practice database: programa, estudiante, tutor_academico, asesor_pedagogico, director, institucion,
# tipopractica, practica, actividad, evidenciaactividad, evidenciaarchivo, retroalimentacion_t/_a
DATABASE_URL_PRACTICE=postgresql://usuario:clave@host/postgres_1?sslmode=require&channel_binding=require
# Evaluation database: pregunta, evaluacion, respuesta, retropregunta
DATABASE_URL_EVALUATION=postgresql://usuario:clave@host/postgres_2?sslmode=require&channel_binding=require

# ===== MongoDB Atlas =====
# Audit log + accreditation indicators
MONGO_URI_PRIMARY=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/base_mongo_1?appName=Cluster0
# Notification queue (consumed by the mail microservice)
MONGO_URI_NOTIFICATIONS=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/base_mongo_2?appName=Cluster0

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Director (npm run director:create) =====
# If your director ALREADY exists in the director table, put their e-mail without the @domain here (e.g. hmancilla1)
# and a NEW password for Supabase: their data is left untouched. If they do not exist, they are created with this data.
DIRECTOR_FIRST_NAMES=
DIRECTOR_LAST_NAMES=
DIRECTOR_DOCUMENT=
DIRECTOR_USERNAME=
DIRECTOR_PASSWORD=

# ===== Optional =====
# LOGIN_MAX_ATTEMPTS=10   # login attempts per IP every 15 minutes

# NOTE: the former Spanish variable names (DATABASE_URL_ESTUDIANTE, DATABASE_URL_EVALUACION, MONGO_URI_BASE1,
# MONGO_URI_BASE2, DOMINIO_INSTITUCIONAL, LOGIN_MAX_INTENTOS, DIRECTOR_NOMBRES, DIRECTOR_APELLIDOS,
# DIRECTOR_DOCUMENTO, DIRECTOR_USUARIO) are still honoured, so an existing .env keeps working.
