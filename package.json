{
  "name": "spp-pedagogical-practice-software",
  "version": "2.0.0",
  "description": "SPP - Pedagogical Practice Software (layered architecture: routes > controllers > services > repositories; Express, Supabase Auth, PostgreSQL, MongoDB, Cloudinary)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "schema:apply": "node src/scripts/apply-schema.js",
    "schema:verify": "node src/scripts/verify-schema.js",
    "director:create": "node src/scripts/create-director.js",
    "users:migrate": "node src/scripts/migrate-users.js",
    "test": "npm run test:unit && npm run test:repositories && npm run test:e2e",
    "test:unit": "node tests/unit.test.js",
    "test:repositories": "node tests/repositories.test.js",
    "test:e2e": "node tests/e2e-http.test.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cloudinary": "^2.5.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
