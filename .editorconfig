root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The browser code and the stylesheets were written with 4-space indentation
[public/js/**.js]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
